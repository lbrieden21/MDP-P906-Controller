    {
      "name": "cores-teensy4",
      "description": "PJRC Teensy 4.x core (Teensy 4.0/4.1)",
      "license": "MIT",
      "homepage": "https://github.com/PaulStoffregen/cores",
      "pin": {
        "type": "commit",
        "value": "7f107ee0a309f3813ed13f0d8f615497eca2ee49"
      },
      "archive_url": "https://github.com/PaulStoffregen/cores/archive/7f107ee0a309f3813ed13f0d8f615497eca2ee49.tar.gz",
      "extract": [
        {
          "from": "teensy4",
          "to": "nrf_adapter_source_multiceiver/Drivers/teensy4"
        }
      ],
      "exclude": [
        "Blink.cc"
      ],
      "patch": [
        {
          "file": "nrf_adapter_source_multiceiver/Drivers/teensy4/imxrt1062_t41.ld",
          "find": ".ARM.exidx* .ARM.extab.text* .gnu.linkonce.armexidx.*",
          "replace": ".ARM.exidx* .ARM.extab* .gnu.linkonce.armexidx.*",
          "why": "Without this, BOARD=TEENSY41 ETH=1 fails to link with 'relocation truncated to fit: R_ARM_PREL31' -- libgcc's unwind objects carry a plain .ARM.extab that falls through to orphan placement in ITCM, past the 31-bit encoding's range. Root-caused in plans/nrf_adapter_teensy_ethernet_link_plan.md Phase 0. No-op for every other build."
        }
      ],
      "note": "PJRC's MIT variant carries a non-standard clause 2: any build system offering a list of target devices must list similar PJRC.COM devices alongside it. Identical to upstream except Blink.cc (excluded, an example file never built) and the imxrt1062_t41.ld patch above. Despite -DTEENSYDUINO=159 in the target Makefiles, this is master at 7f107ee0, post-Teensyduino-1.62 -- see plans/devendoring_plan.md for why the version number stays.",
      "tree_sha256": "948e4ad9398ea3c6cf5ed5172cb2341e44da594855eb5d770252b64f19799d64"
    },
